{
    "$schema": "https://opencode.ai/config.json",
    "model": "palantir-openai/gpt-6-sol",
    "agents": {
        "title": {
            "model": "palantir-openai/gpt-6-luna"
        }
    },
    "update": "disable",
    "share": "disabled",
    "policies": [
        {
            "action": "provider.use",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "provider.use",
            "resource": "palantir-openai",
            "effect": "allow"
        },
        {
            "action": "provider.use",
            "resource": "palantir-anthropic",
            "effect": "allow"
        },
        {
            "action": "integration.use",
            "resource": "plugin:context-mode",
            "effect": "deny"
        }
    ],
    "plugins": [
        "@dietrichgebert/ponytail@5.3.2",
        "./plugins/lms-responses-compat",
        "-context-mode"
    ],
    "providers": {
        "palantir-openai": {
            "canonical": "openai",
            "name": "Palantir OpenAI",
            "package": "@opencode/ai/providers/openai/responses",
            "settings": {
                "timeout": false,
                "headerTimeout": 60000,
                "transport": "http",
                "encoding": "none"
            },
            "models": {
                "gpt-6-sol": {
                    "name": "Foundry GPT-6 Sol",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.gpt-6-sol"
                },
                "gpt-6-1-terra": {
                    "name": "Foundry GPT-6.1 Terra",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.gpt-6-1-terra"
                },
                "gpt-6-luna": {
                    "name": "Foundry GPT-6 Luna",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.gpt-6-luna"
                },
                "gpt-6-astra": {
                    "name": "Foundry GPT-6 Astra",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.gpt-6-astra"
                },
                "gpt-5.6-sol": {
                    "name": "Foundry GPT-5.6 Sol",
                    "modelID": "ri.language-model-service..language-model.gpt-5-6-sol"
                },
                "gpt-5.6-luna": {
                    "name": "Foundry GPT-5.6 Luna",
                    "modelID": "ri.language-model-service..language-model.gpt-5-6-luna"
                },
                "gpt-5.6-terra": {
                    "name": "Foundry GPT-5.6 Terra",
                    "modelID": "ri.language-model-service..language-model.gpt-5-6-terra"
                },
                "gpt-5.5": {
                    "name": "Foundry GPT-5.5",
                    "limit": {
                        "context": 1050000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.gpt-5-5"
                },
                "gpt-5.4": {
                    "name": "Foundry GPT-5.4",
                    "modelID": "ri.language-model-service..language-model.gpt-5-4"
                },
                "gpt-5.4-mini": {
                    "name": "Foundry GPT-5.4 mini",
                    "modelID": "ri.language-model-service..language-model.gpt-5-4-mini"
                },
                "gpt-5.4-nano": {
                    "name": "Foundry GPT-5.4 nano",
                    "modelID": "ri.language-model-service..language-model.gpt-5-4-nano"
                },
                "gpt-5.3-codex": {
                    "name": "Foundry GPT-5.3 Codex",
                    "modelID": "ri.language-model-service..language-model.gpt-5-3-codex"
                },
                "gpt-5.2": {
                    "name": "Foundry GPT-5.2",
                    "modelID": "ri.language-model-service..language-model.gpt-5-2"
                },
                "gpt-5.1": {
                    "name": "Foundry GPT-5.1",
                    "modelID": "ri.language-model-service..language-model.gpt-5-1"
                },
                "gpt-5.1-codex": {
                    "name": "Foundry GPT-5.1 Codex",
                    "modelID": "ri.language-model-service..language-model.gpt-5-1-codex"
                },
                "gpt-5.1-codex-mini": {
                    "name": "Foundry GPT-5.1 Codex mini",
                    "modelID": "ri.language-model-service..language-model.gpt-5-1-codex-mini"
                },
                "gpt-5": {
                    "name": "Foundry GPT-5",
                    "modelID": "ri.language-model-service..language-model.gpt-5"
                },
                "gpt-5-codex": {
                    "name": "Foundry GPT-5 Codex",
                    "modelID": "ri.language-model-service..language-model.gpt-5-codex"
                },
                "gpt-5-mini": {
                    "name": "Foundry GPT-5 mini",
                    "modelID": "ri.language-model-service..language-model.gpt-5-mini"
                },
                "gpt-5-nano": {
                    "name": "Foundry GPT-5 nano",
                    "modelID": "ri.language-model-service..language-model.gpt-5-nano"
                },
                "gpt-4.1": {
                    "name": "Foundry GPT-4.1",
                    "modelID": "ri.language-model-service..language-model.gpt-4-1"
                },
                "gpt-4.1-mini": {
                    "name": "Foundry GPT-4.1 mini",
                    "modelID": "ri.language-model-service..language-model.gpt-4-1-mini"
                },
                "gpt-4.1-nano": {
                    "name": "Foundry GPT-4.1 nano",
                    "modelID": "ri.language-model-service..language-model.gpt-4-1-nano"
                },
                "gpt-4o": {
                    "name": "Foundry GPT-4o",
                    "modelID": "ri.language-model-service..language-model.gpt-4-o"
                },
                "o3": {
                    "name": "Foundry o3",
                    "modelID": "ri.language-model-service..language-model.o-3"
                },
                "o4-mini": {
                    "name": "Foundry o4-mini",
                    "modelID": "ri.language-model-service..language-model.o-4-mini"
                },
                "codex-auto-review": {
                    "name": "Foundry Codex Auto Review",
                    "limit": {
                        "context": 400000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.codex-auto-review"
                }
            }
        },
        "palantir-anthropic": {
            "canonical": "anthropic",
            "name": "Palantir Anthropic",
            "package": "@opencode/ai/providers/anthropic",
            "settings": {
                "timeout": false,
                "transport": "http",
                "encoding": "none"
            },
            "models": {
                "claude-haiku-4-5": {
                    "name": "Foundry Claude Haiku 4.5",
                    "modelID": "claude-haiku-4-5",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 4000
                        }
                    }
                },
                "claude-opus-4-1": {
                    "name": "Foundry Claude Opus 4.1",
                    "modelID": "claude-opus-4-1",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                },
                "claude-opus-4-5": {
                    "name": "Foundry Claude Opus 4.5",
                    "modelID": "claude-opus-4-5",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                },
                "claude-opus-4-6": {
                    "name": "Foundry Claude Opus 4.6",
                    "modelID": "claude-opus-4-6",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                },
                "claude-opus-4-7": {
                    "name": "Foundry Claude Opus 4.7",
                    "modelID": "claude-opus-4-7",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-4-8": {
                    "name": "Foundry Claude Opus 4.8",
                    "modelID": "claude-opus-4-8",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-5": {
                    "name": "Foundry Claude Opus 5",
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.anthropic-claude-5-opus",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-opus-5-5": {
                    "name": "Foundry Claude Opus 5.5",
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    },
                    "modelID": "ri.language-model-service..language-model.anthropic-claude-5-5-opus",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    }
                },
                "claude-sonnet-4-5": {
                    "name": "Foundry Claude Sonnet 4.5",
                    "modelID": "claude-sonnet-4-5",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                },
                "claude-sonnet-4-6": {
                    "name": "Foundry Claude Sonnet 4.6",
                    "modelID": "claude-sonnet-4-6",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image", "pdf"],
                        "output": ["text"]
                    },
                    "settings": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    }
                }
            }
        }
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "skill",
            "resource": "rubberducky",
            "effect": "deny"
        }
    ],
    "lsp": {
        "typescript-language-server": {
            "command": ["typescript-language-server", "--stdio"],
            "extensions": [".ts", ".tsx", ".js", ".jsx"]
        },
        "clangd": {
            "command": ["clangd", "--background-index", "--clang-tidy"],
            "extensions": [".c", ".h", ".cpp", ".hpp"]
        },
        "rust-analyzer": {
            "command": ["rust-analyzer"],
            "extensions": [".rs"]
        },
        "pyright": {
            "command": ["pyright-langserver", "--stdio"],
            "extensions": [".py"]
        },
        "intelephense": {
            "command": ["intelephense", "--stdio"],
            "extensions": [".php"]
        }
    }
}
