{
  "$schema": "https://opencode.ai/config.json",
  "model": "palantir-openai/gpt-6-sol",
  "agents": {
    "title": {
      "model": "palantir-openai/gpt-6-luna"
    }
  },
  "update": "disable",
  "share": "disabled",
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "palantir-openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "palantir-anthropic",
      "effect": "allow"
    },
    {
      "action": "integration.use",
      "resource": "plugin:context-mode",
      "effect": "deny"
    }
  ],
  "plugins": [
    "@dietrichgebert/ponytail@5.3.2",
    "./plugins/lms-responses-compat"
  ],
  "providers": {
    "palantir-openai": {
      "canonical": "openai",
      "name": "Palantir OpenAI",
      "env": [
        "OPENCODE_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai/responses",
      "settings": {
        "baseURL": "{env:OPENCODE_BASE_URL}/language-model-service/api/proxy/openai/v1",
        "apiKey": "{env:OPENCODE_API_KEY}",
        "timeout": false,
        "headerTimeout": 60000,
        "transport": "http",
        "encoding": "none"
      },
      "headers": {
        "Authorization": "Bearer {env:OPENCODE_API_KEY}"
      },
      "models": {
        "gpt-6-sol": {
          "name": "Foundry GPT-6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.gpt-6-sol"
        },
        "gpt-6-luna": {
          "name": "Foundry GPT-6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.gpt-6-luna"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.gpt-6-astra"
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "modelID": "ri.language-model-service..language-model.gpt-5-6-sol"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "modelID": "ri.language-model-service..language-model.gpt-5-6-luna"
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "modelID": "ri.language-model-service..language-model.gpt-5-6-terra"
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.gpt-5-5"
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "modelID": "ri.language-model-service..language-model.gpt-5-4"
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 mini",
          "modelID": "ri.language-model-service..language-model.gpt-5-4-mini"
        },
        "gpt-5.4-nano": {
          "name": "GPT-5.4 nano",
          "modelID": "ri.language-model-service..language-model.gpt-5-4-nano"
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "modelID": "ri.language-model-service..language-model.gpt-5-3-codex"
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "modelID": "ri.language-model-service..language-model.gpt-5-2"
        },
        "gpt-5.1": {
          "name": "GPT-5.1",
          "modelID": "ri.language-model-service..language-model.gpt-5-1"
        },
        "gpt-5.1-codex": {
          "name": "GPT-5.1 Codex",
          "modelID": "ri.language-model-service..language-model.gpt-5-1-codex"
        },
        "gpt-5.1-codex-mini": {
          "name": "GPT-5.1 Codex mini",
          "modelID": "ri.language-model-service..language-model.gpt-5-1-codex-mini"
        },
        "gpt-5": {
          "name": "GPT-5",
          "modelID": "ri.language-model-service..language-model.gpt-5"
        },
        "gpt-5-codex": {
          "name": "GPT-5 Codex",
          "modelID": "ri.language-model-service..language-model.gpt-5-codex"
        },
        "gpt-5-mini": {
          "name": "GPT-5 mini",
          "modelID": "ri.language-model-service..language-model.gpt-5-mini"
        },
        "gpt-5-nano": {
          "name": "GPT-5 nano",
          "modelID": "ri.language-model-service..language-model.gpt-5-nano"
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "modelID": "ri.language-model-service..language-model.gpt-4-1"
        },
        "gpt-4.1-mini": {
          "name": "GPT-4.1 mini",
          "modelID": "ri.language-model-service..language-model.gpt-4-1-mini"
        },
        "gpt-4.1-nano": {
          "name": "GPT-4.1 nano",
          "modelID": "ri.language-model-service..language-model.gpt-4-1-nano"
        },
        "gpt-4o": {
          "name": "GPT-4o",
          "modelID": "ri.language-model-service..language-model.gpt-4-o"
        },
        "o3": {
          "name": "o3",
          "modelID": "ri.language-model-service..language-model.o-3"
        },
        "o4-mini": {
          "name": "o4-mini",
          "modelID": "ri.language-model-service..language-model.o-4-mini"
        },
        "codex-auto-review": {
          "name": "Codex Auto Review",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.codex-auto-review"
        }
      }
    },
    "palantir-anthropic": {
      "canonical": "anthropic",
      "name": "Palantir Anthropic",
      "env": [
        "OPENCODE_API_KEY"
      ],
      "package": "@opencode/ai/providers/anthropic",
      "settings": {
        "baseURL": "{env:OPENCODE_BASE_URL}/api/v2/llm/proxy/anthropic/v1",
        "apiKey": "{env:OPENCODE_API_KEY}",
        "timeout": false,
        "transport": "http",
        "encoding": "none"
      },
      "headers": {
        "Authorization": "Bearer {env:OPENCODE_API_KEY}"
      },
      "models": {
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "modelID": "claude-haiku-4-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 4000
            }
          }
        },
        "claude-opus-4-1": {
          "name": "Claude Opus 4.1",
          "modelID": "claude-opus-4-1",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-opus-4-5": {
          "name": "Claude Opus 4.5",
          "modelID": "claude-opus-4-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "modelID": "claude-opus-4-6",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7",
          "modelID": "claude-opus-4-7",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "modelID": "claude-opus-4-8",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.anthropic-claude-5-opus",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modelID": "ri.language-model-service..language-model.anthropic-claude-5-5-opus",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5",
          "modelID": "claude-sonnet-4-5",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "modelID": "claude-sonnet-4-6",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "lsp": {
    "typescript-language-server": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "clangd": {
      "command": [
        "clangd",
        "--background-index",
        "--clang-tidy"
      ],
      "extensions": [
        ".c",
        ".h",
        ".cpp",
        ".hpp"
      ]
    },
    "rust-analyzer": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "pyright": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ]
    },
    "intelephense": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ]
    }
  },
  "mcp": {
    "servers": {
      "palantir": {
        "type": "local",
        "command": [
          "direnv",
          "exec",
          ".",
          "sh",
          "-c",
          "FOUNDRY_TOKEN=\"$OPENCODE_API_KEY\" exec npx -y palantir-mcp --foundry-api-url \"$OPENCODE_BASE_URL\""
        ],
        "disabled": false
      }
    }
  }
}
